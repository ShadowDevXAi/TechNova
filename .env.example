# Copy to .env and replace every example value before use.
# Docker Compose creates the MongoDB URI for the backend automatically.
MONGO_ROOT_USER=technova
MONGO_ROOT_PASSWORD=replace-with-a-unique-long-alphanumeric-password

# Required backend application configuration
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=720
DATABASE_NAME=technova
BOOTSTRAP_FOUNDER_NAME=TechNova Founder
BOOTSTRAP_FOUNDER_EMAIL=founder@example.com
BOOTSTRAP_FOUNDER_PASSWORD=replace-with-a-strong-password-12-characters-minimum

# Comma-separated browser origins; no trailing slashes.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,https://technova-1-qx44.onrender.com
PUBLIC_APP_URL=http://localhost:8080

# Password reset is disabled until you opt into a delivery mode.
RESET_DELIVERY_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
