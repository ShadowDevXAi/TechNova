# Copy this file to .env for local development and replace every placeholder.
# Never commit .env or put server secrets in frontend VITE_* variables.

MONGO_ROOT_USER=technova
MONGO_ROOT_PASSWORD=replace-with-a-strong-random-password
MONGODB_URI=mongodb://technova:replace-with-a-strong-random-password@localhost:27017/technova?authSource=admin
DATABASE_NAME=technova

# Use at least 32 random characters; rotate the old value if it was ever committed.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720

FRONTEND_ORIGINS=https://technova-1-qx44.onrender.com
PUBLIC_APP_URL=https://technova-1-qx44.onrender.com

BOOTSTRAP_FOUNDER_NAME=TechNova Founder
BOOTSTRAP_FOUNDER_EMAIL=founder@example.com
BOOTSTRAP_FOUNDER_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Recommended for Render Free: Brevo HTTPS API (uses outbound HTTPS, not SMTP ports).
# Create an API key in Brevo Settings > SMTP & API > API keys.
# Use the Brevo API key here (NOT the SMTP key). Keep blank if using SMTP instead.
BREVO_API_KEY=
BREVO_SENDER_NAME=TechNova
# Optional Brevo transactional SMS sender; must be approved/registered in your Brevo account.
BREVO_SMS_SENDER=TechNova

# Optional SMTP fallback for paid hosts/local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional Firebase Admin Secret File mounted by Render.
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=technova-f4460

# Optional durable task attachments. Local is development-only; use a private S3-compatible bucket in production.
ATTACHMENT_STORAGE_PROVIDER=local
# For Cloudflare R2, use https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
